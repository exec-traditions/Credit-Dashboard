# ── Supabase ──────────────────────────────────────────────────
# From: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth ──────────────────────────────────────────────────────
# Single shared password for Katie + Stephen. Pick something strong.
APP_PASSWORD=change-me-to-something-strong

# JWT secret for signing session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=change-me-to-32-random-bytes

# ── Email (optional — for future digest emails via Resend) ────
RESEND_API_KEY=re_xxxxxxxx

# ── Deployment ────────────────────────────────────────────────
# Leave empty locally; set on Vercel automatically
NEXT_PUBLIC_APP_URL=http://localhost:3000
